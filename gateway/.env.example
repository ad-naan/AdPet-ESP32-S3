# ---- 必填 ----
MIMO_API_KEY=your_mimo_api_key_here

# ---- 可选 ----
# MIMO API 基地址
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 网关共享密钥（留空则不验证）
# GATEWAY_API_KEY=

# 模型配置
# ASR_MODEL=mimo-v2.5-asr
# LLM_MODEL=mimo-v2.5
# TTS_MODEL=mimo-v2.5-tts
# TTS_VOICE=Chloe

# 对话记忆
# MAX_HISTORY_TURNS=8

# 音频限制（字节）
# MAX_WAV_SIZE=225280

# 服务端固定人设提示（与设备提示合并）
# SERVER_SYSTEM_PROMPT=你是 AdPet，一只可爱的桌面电子宠物。用简短、温暖、可爱的语气回复。

# 服务器
# HOST=0.0.0.0
# PORT=8787
